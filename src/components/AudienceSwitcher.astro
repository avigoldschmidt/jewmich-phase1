---
import type { Audience } from '../lib/nav';
import { SITE } from '../lib/nav';
import { withBase } from '../lib/paths';

interface Props {
  audience: Audience;
  compact?: boolean;
  tone?: 'dark' | 'light';
}

const { audience, compact = false, tone = 'dark' } = Astro.props;
const current =
  audience === 'community' || audience === 'youth' ? 'community' : 'students';
---

<nav
  class:list={[
    'audience-switcher',
    `audience-switcher--${tone}`,
    compact && 'audience-switcher--compact',
  ]}
  aria-label="Audience"
>
  <a
    class:list={[
      'audience-switcher__link',
      current === 'students' && 'is-active',
    ]}
    href={withBase(SITE.homes.students)}
    aria-current={current === 'students' ? 'page' : undefined}
  >
    Students
  </a>
  <a
    class:list={[
      'audience-switcher__link',
      current === 'community' && 'is-active',
    ]}
    href={withBase(SITE.homes.community)}
    aria-current={current === 'community' ? 'page' : undefined}
  >
    Community
  </a>
</nav>

<style>
  .audience-switcher {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    padding: 1px;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .audience-switcher--dark {
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
  }

  .audience-switcher--dark .audience-switcher__link {
    color: rgba(255, 255, 255, 0.68);
  }

  .audience-switcher--dark .audience-switcher__link:hover {
    color: #fff;
  }

  .audience-switcher--dark .audience-switcher__link.is-active {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .audience-switcher--light {
    border: 1px solid var(--line-strong);
    background: var(--mist);
  }

  .audience-switcher--light .audience-switcher__link {
    color: var(--color-muted);
  }

  .audience-switcher--light .audience-switcher__link:hover {
    color: var(--color-ink);
  }

  .audience-switcher--light .audience-switcher__link.is-active {
    background: var(--color-ink);
    color: #fff;
  }

  .audience-switcher__link {
    text-decoration: none;
    padding: 0.22rem 0.55rem;
    border-radius: calc(var(--radius) - 1px);
    min-height: 1.55rem;
    display: inline-flex;
    align-items: center;
  }

  .audience-switcher--compact {
    font-size: 0.72rem;
  }
</style>
