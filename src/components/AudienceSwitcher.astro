---
import type { Audience } from '../lib/nav';
import { SITE } from '../lib/nav';
import { withBase } from '../lib/paths';

interface Props {
  audience: Audience;
  compact?: boolean;
}

const { audience, compact = false } = Astro.props;
const current =
  audience === 'community' || audience === 'youth' ? 'community' : 'students';
---

<nav
  class:list={[
    'audience-switcher',
    compact && 'audience-switcher--compact',
  ]}
  aria-label="Audience"
>
  <a
    class:list={[
      'audience-switcher__link',
      current === 'students' && 'is-active',
    ]}
    href={withBase(SITE.homes.students)}
    aria-current={current === 'students' ? 'page' : undefined}
  >
    Students
  </a>
  <a
    class:list={[
      'audience-switcher__link',
      current === 'community' && 'is-active',
    ]}
    href={withBase(SITE.homes.community)}
    aria-current={current === 'community' ? 'page' : undefined}
  >
    Community
  </a>
</nav>

<style>
  .audience-switcher {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    padding: 2px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .audience-switcher__link {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    padding: 0.32rem 0.68rem;
    border-radius: calc(var(--radius) - 2px);
    min-height: 1.9rem;
    display: inline-flex;
    align-items: center;
  }

  .audience-switcher__link:hover {
    color: #fff;
  }

  .audience-switcher__link.is-active {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .audience-switcher--compact {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
  }
</style>
