---
import { withBase } from '../lib/paths';

interface Props {
  href: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  /** Open in the same tab (WordPress forms, RSVPs). Default: same tab for all. */
  sameTab?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = 'primary',
  external,
  sameTab = true,
  class: className,
} = Astro.props;

const isExternal =
  external ?? (/^https?:\/\//.test(href) || href.startsWith('mailto:'));
const resolvedHref = isExternal ? href : withBase(href);
const openNewTab = isExternal && !sameTab;
---

<a
  class:list={['cta-link', `cta-link--${variant}`, className]}
  href={resolvedHref}
  {...(openNewTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot>{label}</slot>
</a>

<style>
  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0.7rem 1.25rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease),
      color 180ms var(--ease),
      border-color 180ms var(--ease);
  }

  .cta-link--primary {
    background: var(--color-ink);
    color: var(--color-page);
  }

  .cta-link--primary:hover {
    background: var(--color-night);
    color: #fff;
  }

  .cta-link--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: rgba(19, 33, 58, 0.22);
  }

  .cta-link--secondary:hover {
    border-color: var(--color-brass-text);
    color: var(--color-ink);
  }

  .cta-link--text {
    background: transparent;
    color: var(--color-brass-text);
    padding-inline: 0.15rem;
    min-height: 2.75rem;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cta-link--text:hover {
    color: var(--color-ink);
  }
</style>
