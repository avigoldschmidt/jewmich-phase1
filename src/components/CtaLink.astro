---
import { withBase } from '../lib/paths';

interface Props {
  href: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'maize';
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = 'primary',
  external,
  class: className,
} = Astro.props;

const isExternal =
  external ?? (/^https?:\/\//.test(href) || href.startsWith('mailto:'));
const resolvedHref = isExternal ? href : withBase(href);
---

<a
  class:list={['cta-link', `cta-link--${variant}`, className]}
  href={resolvedHref}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot>{label}</slot>
</a>

<style>
  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0.7rem 1.25rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease),
      color 180ms var(--ease),
      border-color 180ms var(--ease);
  }

  .cta-link--primary {
    background: var(--color-ink);
    color: var(--color-page);
  }

  .cta-link--primary:hover {
    background: #1c1e24;
    color: #fff;
  }

  .cta-link--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: rgba(14, 15, 18, 0.22);
  }

  .cta-link--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  /* Maize kept as a rare student cue — hairline border, not a full-page wash */
  .cta-link--maize {
    background: var(--color-ink);
    color: var(--color-page);
    box-shadow: inset 0 -2px 0 0 var(--color-maize);
  }

  .cta-link--maize:hover {
    background: #1c1e24;
    color: #fff;
  }
</style>
