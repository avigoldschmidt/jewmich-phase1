---
import CtaLink from './CtaLink.astro';
import { withBase } from '../lib/paths';

interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'maize';
  external?: boolean;
}

interface Props {
  brand: string;
  headline: string;
  sentence: string;
  imageSrc: string;
  imageAlt: string;
  ctas?: Cta[];
  tone?: 'students' | 'community';
  placeholderNote?: string;
}

const {
  brand,
  headline,
  sentence,
  imageSrc,
  imageAlt,
  ctas = [],
  tone = 'students',
  placeholderNote,
} = Astro.props;

const resolvedImage = withBase(imageSrc);
---

<section class:list={['hero', `hero--${tone}`]} aria-label="Hero">
  <div class="hero__media" aria-hidden="true">
    <img src={resolvedImage} alt="" width="1920" height="1080" />
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__content container">
    <p class="hero__brand">{brand}</p>
    <h1 class="hero__headline">{headline}</h1>
    <p class="hero__sentence">{sentence}</p>
    {
      ctas.length > 0 && (
        <div class="cta-row hero__ctas">
          {ctas.map((cta, i) => (
            <CtaLink
              href={cta.href}
              label={cta.label}
              variant={
                cta.variant ??
                (i === 0 ? (tone === 'students' ? 'maize' : 'primary') : 'secondary')
              }
              external={cta.external}
              class="hero__cta"
            />
          ))}
        </div>
      )
    }
    {
      placeholderNote && (
        <p class="hero__note">{placeholderNote}</p>
      )
    }
  </div>
  <span class="sr-only">{imageAlt}</span>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 46rem);
    display: grid;
    align-items: end;
    color: var(--color-paper);
    overflow: clip;
  }

  .hero__media,
  .hero__veil {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__veil {
    background:
      linear-gradient(
        180deg,
        rgba(11, 31, 58, 0.35) 0%,
        rgba(11, 31, 58, 0.55) 45%,
        rgba(11, 31, 58, 0.88) 100%
      ),
      linear-gradient(90deg, rgba(11, 31, 58, 0.45), transparent 55%);
  }

  .hero--students .hero__veil {
    background:
      linear-gradient(
        180deg,
        rgba(0, 39, 76, 0.3) 0%,
        rgba(11, 31, 58, 0.55) 48%,
        rgba(11, 31, 58, 0.9) 100%
      ),
      linear-gradient(100deg, rgba(0, 39, 76, 0.5), transparent 60%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 10vh, 5.5rem) clamp(2.5rem, 8vh, 4.5rem);
    max-width: 42rem;
    margin-inline: 0 auto 0 0;
    animation: fade-up 700ms var(--ease) both;
  }

  .hero__brand {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.25);
  }

  .hero__headline {
    margin: 0 0 0.85rem;
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    font-weight: 560;
    color: rgba(247, 244, 238, 0.96);
  }

  .hero__sentence {
    margin: 0 0 1.4rem;
    max-width: 32rem;
    font-size: 1.08rem;
    color: rgba(247, 244, 238, 0.86);
  }

  .hero__ctas :global(.cta-link--secondary) {
    color: var(--color-paper);
    border-color: rgba(196, 163, 90, 0.85);
  }

  .hero__ctas :global(.cta-link--secondary:hover) {
    background: rgba(196, 163, 90, 0.18);
    color: #fff;
  }

  .hero__note {
    margin: 1rem 0 0;
    max-width: 28rem;
    font-size: 0.88rem;
    color: rgba(247, 244, 238, 0.65);
  }

  @media (min-width: 900px) {
    .hero__content {
      width: min(100% - 2rem, var(--max-width));
      margin-inline: auto;
      padding-right: 40%;
    }
  }
</style>
