---
import CtaLink from './CtaLink.astro';
import { withBase } from '../lib/paths';

interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'maize';
  external?: boolean;
}

interface Props {
  brand: string;
  headline: string;
  sentence: string;
  imageSrc: string;
  imageAlt: string;
  ctas?: Cta[];
  tone?: 'students' | 'community';
}

const {
  brand,
  headline,
  sentence,
  imageSrc,
  imageAlt,
  ctas = [],
  tone = 'students',
} = Astro.props;

const resolvedImage = withBase(imageSrc);
---

<section class:list={['hero', `hero--${tone}`]} aria-label="Hero">
  <div class="hero__media" aria-hidden="true">
    <img src={resolvedImage} alt="" width="1920" height="1080" />
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__content container">
    {
      tone === 'students' && (
        <p class="hero__cue">For University of Michigan students</p>
      )
    }
    <p class="hero__brand">{brand}</p>
    <h1 class="hero__headline">{headline}</h1>
    <p class="hero__sentence">{sentence}</p>
    {
      ctas.length > 0 && (
        <div class="cta-row hero__ctas">
          {ctas.map((cta, i) => (
            <CtaLink
              href={cta.href}
              label={cta.label}
              variant={
                cta.variant ?? (i === 0 ? (tone === 'students' ? 'maize' : 'primary') : 'secondary')
              }
              external={cta.external}
              class="hero__cta"
            />
          ))}
        </div>
      )
    }
  </div>
  <span class="sr-only">{imageAlt}</span>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 46rem);
    display: grid;
    align-items: end;
    color: var(--color-page);
    overflow: clip;
  }

  .hero__media,
  .hero__veil {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__veil {
    background: linear-gradient(
      180deg,
      rgba(14, 15, 18, 0.28) 0%,
      rgba(14, 15, 18, 0.45) 42%,
      rgba(14, 15, 18, 0.88) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 10vh, 5.5rem) clamp(2.5rem, 8vh, 4.5rem);
    max-width: 40rem;
    margin-inline: 0 auto 0 0;
    animation: fade-up 700ms var(--ease) both;
  }

  .hero__cue {
    margin: 0 0 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(251, 251, 250, 0.78);
    border-left: 2px solid var(--color-maize);
    padding-left: 0.55rem;
  }

  .hero__brand {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 6vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: #fff;
  }

  .hero__headline {
    margin: 0 0 0.75rem;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 520;
    color: rgba(251, 251, 250, 0.94);
  }

  .hero__sentence {
    margin: 0 0 1.4rem;
    max-width: 32rem;
    font-family: var(--font-ui);
    font-size: 1.05rem;
    color: rgba(251, 251, 250, 0.82);
  }

  .hero__ctas :global(.cta-link--secondary) {
    color: var(--color-page);
    border-color: rgba(251, 251, 250, 0.45);
  }

  .hero__ctas :global(.cta-link--secondary:hover) {
    border-color: var(--color-accent);
    color: #fff;
  }

  @media (min-width: 900px) {
    .hero__content {
      width: min(100% - 2rem, var(--max-width));
      margin-inline: auto;
      padding-right: 38%;
    }
  }
</style>
