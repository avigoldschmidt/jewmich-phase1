---
import CtaLink from './CtaLink.astro';
import { withBase } from '../lib/paths';

interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  sameTab?: boolean;
}

interface Props {
  brand: string;
  headline: string;
  sentence: string;
  imageSrc?: string;
  imageAlt?: string;
  ctas?: Cta[];
  tone?: 'students' | 'community';
}

const {
  brand,
  headline,
  sentence,
  imageSrc,
  imageAlt = '',
  ctas = [],
  tone = 'students',
} = Astro.props;

const resolvedImage = imageSrc ? withBase(imageSrc) : undefined;
---

<section class:list={['hero', `hero--${tone}`]} aria-label="Hero">
  <div class="hero__plane" aria-hidden={imageAlt ? undefined : 'true'}>
    {
      resolvedImage ? (
        <img
          class="hero__photo"
          src={resolvedImage}
          alt=""
          width="1920"
          height="1080"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <div class="hero__fallback"></div>
      )
    }
    <div class="hero__veil"></div>
  </div>

  <div class="hero__content container">
    <p class="hero__brand">{brand}</p>
    <h1 class="hero__headline">{headline}</h1>
    <p class="hero__sentence">{sentence}</p>
    {
      ctas.length > 0 && (
        <div class="cta-row hero__ctas">
          {ctas.map((cta, i) => (
            <CtaLink
              href={cta.href}
              label={cta.label}
              variant={cta.variant ?? (i === 0 ? 'primary' : 'secondary')}
              external={cta.external}
              sameTab={cta.sameTab ?? true}
              class={i === 0 ? 'cta-link--on-photo' : 'cta-link--on-photo-secondary'}
            />
          ))}
        </div>
      )
    }
  </div>
  {imageAlt && <span class="sr-only">{imageAlt}</span>}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(72vh, 40rem);
    display: grid;
    align-items: end;
    color: var(--color-on-photo);
    overflow: hidden;
  }

  .hero__plane {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__photo,
  .hero__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: hero-settle 1.25s var(--ease) both;
  }

  .hero--students .hero__photo {
    object-position: center 42%;
  }

  .hero--community .hero__photo {
    object-position: center 38%;
  }

  .hero__fallback {
    background: linear-gradient(155deg, #12324d 0%, #06101c 70%);
  }

  /* Soft left scrim — keep photo readable */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        92deg,
        rgba(6, 16, 28, 0.66) 0%,
        rgba(6, 16, 28, 0.4) 34%,
        rgba(6, 16, 28, 0.12) 64%,
        rgba(6, 16, 28, 0.16) 100%
      ),
      linear-gradient(to top, rgba(6, 16, 28, 0.34) 0%, transparent 36%);
  }

  .hero--community .hero__veil {
    background:
      linear-gradient(
        92deg,
        rgba(6, 16, 28, 0.68) 0%,
        rgba(6, 16, 28, 0.42) 36%,
        rgba(6, 16, 28, 0.14) 66%,
        rgba(6, 16, 28, 0.2) 100%
      ),
      linear-gradient(to top, rgba(6, 16, 28, 0.32) 0%, transparent 38%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    padding-block: clamp(3.25rem, 9vh, 5rem) clamp(2.1rem, 5.5vh, 3.25rem);
    animation: fade-up 700ms var(--ease) both;
  }

  /* Brand: elegant hero signal */
  .hero__brand {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.2rem);
    font-weight: 600;
    font-optical-sizing: auto;
    letter-spacing: -0.026em;
    line-height: 1.05;
    color: var(--color-on-photo);
  }

  .hero--students .hero__brand::after {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: 0.5rem;
    background: var(--color-maize);
  }

  /* Headline: subordinate — UI face, not second brand shout */
  .hero__headline {
    margin: 0 0 0.55rem;
    font-family: var(--font-ui);
    font-size: clamp(1.12rem, 1.9vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.96);
    max-width: 26rem;
  }

  .hero__sentence {
    margin: 0 0 1.25rem;
    max-width: 27rem;
    font-family: var(--font-ui);
    font-size: 0.98rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.84);
  }

  @media (min-width: 900px) {
    .hero {
      min-height: min(76vh, 42rem);
      align-items: center;
    }

    .hero__content {
      padding-block: clamp(4rem, 11vh, 6rem);
    }
  }
</style>
