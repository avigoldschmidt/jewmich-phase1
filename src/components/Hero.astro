---
import CtaLink from './CtaLink.astro';
import { withBase } from '../lib/paths';

interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  sameTab?: boolean;
}

interface Props {
  brand: string;
  headline: string;
  sentence: string;
  imageSrc?: string;
  imageAlt?: string;
  ctas?: Cta[];
  tone?: 'students' | 'community';
}

const {
  brand,
  headline,
  sentence,
  imageSrc,
  imageAlt = '',
  ctas = [],
  tone = 'students',
} = Astro.props;

const resolvedImage = imageSrc ? withBase(imageSrc) : undefined;
---

<section class:list={['hero', `hero--${tone}`]} aria-label="Hero">
  <div class="hero__plane" aria-hidden={imageAlt ? undefined : 'true'}>
    {
      resolvedImage ? (
        <img
          class="hero__photo"
          src={resolvedImage}
          alt=""
          width="1600"
          height="1000"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <div class="hero__fallback"></div>
      )
    }
    <div class="hero__veil"></div>
  </div>

  <div class="hero__content container">
    <p class="hero__brand">{brand}</p>
    <h1 class="hero__headline">{headline}</h1>
    <p class="hero__sentence">{sentence}</p>
    {
      ctas.length > 0 && (
        <div class="cta-row hero__ctas">
          {ctas.map((cta, i) => (
            <CtaLink
              href={cta.href}
              label={cta.label}
              variant={cta.variant ?? (i === 0 ? 'primary' : 'secondary')}
              external={cta.external}
              sameTab={cta.sameTab ?? true}
              class="hero__cta"
            />
          ))}
        </div>
      )
    }
  </div>
  {imageAlt && <span class="sr-only">{imageAlt}</span>}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(78vh, 44rem);
    display: grid;
    align-items: end;
    color: var(--color-on-photo);
    overflow: hidden;
  }

  .hero__plane {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__photo,
  .hero__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    animation: hero-settle 1.4s var(--ease) both;
  }

  .hero__fallback {
    background:
      radial-gradient(ellipse 70% 55% at 70% 30%, rgba(26, 95, 138, 0.45), transparent 60%),
      linear-gradient(160deg, #0e2a45 0%, #06101c 55%, #0a1a2e 100%);
  }

  .hero--students .hero__fallback {
    background:
      radial-gradient(ellipse 55% 45% at 85% 20%, rgba(255, 203, 5, 0.18), transparent 55%),
      linear-gradient(160deg, #0e2a45 0%, #06101c 55%, #0a1a2e 100%);
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgba(6, 16, 28, 0.88) 0%,
        rgba(6, 16, 28, 0.72) 38%,
        rgba(6, 16, 28, 0.35) 68%,
        rgba(6, 16, 28, 0.45) 100%
      ),
      linear-gradient(to top, rgba(6, 16, 28, 0.75) 0%, transparent 45%);
  }

  .hero--community .hero__veil {
    background:
      linear-gradient(
        105deg,
        rgba(6, 16, 28, 0.9) 0%,
        rgba(6, 16, 28, 0.78) 42%,
        rgba(6, 16, 28, 0.4) 72%,
        rgba(6, 16, 28, 0.5) 100%
      ),
      linear-gradient(to top, rgba(6, 16, 28, 0.7) 0%, transparent 48%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    padding-block: clamp(4.5rem, 12vh, 7rem) clamp(2.75rem, 7vh, 4.5rem);
    animation: fade-up 750ms var(--ease) both;
  }

  .hero__brand {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.35rem);
    font-weight: 650;
    font-optical-sizing: auto;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-on-photo);
  }

  .hero--students .hero__brand {
    box-shadow: inset 0 -0.28em 0 rgba(255, 203, 5, 0.55);
    display: inline;
    padding-bottom: 0.05em;
  }

  .hero__headline {
    margin: 0 0 0.85rem;
    font-size: clamp(1.45rem, 2.8vw, 2rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.94);
    max-width: 28rem;
  }

  .hero__sentence {
    margin: 0 0 1.6rem;
    max-width: 30rem;
    font-family: var(--font-body);
    font-size: 1.08rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  .hero__ctas :global(.cta-link--primary) {
    background: var(--color-on-photo);
    color: var(--color-ink);
  }

  .hero__ctas :global(.cta-link--primary:hover) {
    background: var(--color-maize);
    color: var(--color-ink);
  }

  .hero--community .hero__ctas :global(.cta-link--primary:hover) {
    background: #e8eef4;
    color: var(--color-ink);
  }

  .hero__ctas :global(.cta-link--secondary) {
    background: transparent;
    color: var(--color-on-photo);
    border-color: rgba(255, 255, 255, 0.45);
  }

  .hero__ctas :global(.cta-link--secondary:hover) {
    border-color: #fff;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 900px) {
    .hero {
      min-height: min(82vh, 48rem);
      align-items: center;
    }

    .hero__content {
      padding-block: clamp(5rem, 14vh, 8rem);
    }

    .hero__photo {
      object-position: center 30%;
    }
  }
</style>
