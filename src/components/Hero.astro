---
import CtaLink from './CtaLink.astro';
import { withBase } from '../lib/paths';

interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  sameTab?: boolean;
}

interface Props {
  label?: string;
  brand?: string;
  headline: string;
  sentence: string;
  imageSrc?: string;
  imageAlt?: string;
  ctas?: Cta[];
  tone?: 'students' | 'community';
}

const {
  label,
  brand,
  headline,
  sentence,
  imageSrc,
  imageAlt = '',
  ctas = [],
  tone = 'students',
} = Astro.props;

const resolvedImage = imageSrc ? withBase(imageSrc) : undefined;
const defaultLabel =
  label ??
  (tone === 'students'
    ? 'For University of Michigan students'
    : 'Chabad House of Ann Arbor · Since 1975');
---

<section class:list={['hero', `hero--${tone}`]} aria-label="Hero">
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class:list={['hero__label', tone === 'students' && 'hero__label--maize']}>
        {defaultLabel}
      </p>
      {
        brand && (
          <p class="hero__brand">{brand}</p>
        )
      }
      <h1 class="hero__headline">{headline}</h1>
      <p class="hero__sentence">{sentence}</p>
      {
        ctas.length > 0 && (
          <div class="cta-row hero__ctas">
            {ctas.map((cta, i) => (
              <CtaLink
                href={cta.href}
                label={cta.label}
                variant={cta.variant ?? (i === 0 ? 'primary' : 'secondary')}
                external={cta.external}
                sameTab={cta.sameTab ?? true}
                class="hero__cta"
              />
            ))}
          </div>
        )
      }
    </div>

    <div class="hero__media" aria-hidden={imageAlt ? undefined : 'true'}>
      {
        resolvedImage ? (
          <img src={resolvedImage} alt={imageAlt} width="800" height="1000" />
        ) : (
          <div class="hero__placeholder">
            <svg viewBox="0 0 32 40" width="48" height="60" fill="none" aria-hidden="true">
              <path
                d="M16 2c2.8 5.2 9 9.4 9 17.2C25 27 21 34 16 38c-5-4-9-11-9-18.8C7 11.4 13.2 7.2 16 2Z"
                fill="#B8862B"
              ></path>
              <path
                d="M16 8c1.5 3.1 5 5.5 5 10.1 0 5.3-2.2 9.3-5 11.9-2.8-2.6-5-6.6-5-11.9 0-4.6 3.5-7 5-10.1Z"
                fill="#FAF9F6"
                opacity="0.45"
              ></path>
            </svg>
            <p>Chabad House of Ann Arbor</p>
          </div>
        )
      }
      {imageAlt && <span class="sr-only">{imageAlt}</span>}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 6vw, 3.5rem) clamp(2.5rem, 7vw, 4rem);
    background:
      radial-gradient(ellipse 80% 60% at 10% 0%, rgba(241, 238, 231, 0.9), transparent 55%),
      var(--color-page);
  }

  .hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .hero__copy {
    max-width: 36rem;
    animation: fade-up 700ms var(--ease) both;
  }

  .hero__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .hero__label--maize {
    border-left: 3px solid var(--color-maize);
    padding-left: 0.6rem;
  }

  .hero__brand {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 650;
    color: var(--color-ink);
  }

  .hero__headline {
    margin: 0 0 0.85rem;
    font-size: clamp(2.35rem, 5vw, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero__sentence {
    margin: 0 0 1.5rem;
    max-width: 32rem;
    font-size: 1.08rem;
    color: var(--color-muted);
  }

  .hero__media {
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-sand);
    border: 1px solid rgba(19, 33, 58, 0.08);
    aspect-ratio: 16 / 10;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    height: 100%;
    min-height: 14rem;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.85rem;
    padding: 2rem;
    text-align: center;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .hero__placeholder p {
    margin: 0;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
    }

    .hero__media {
      aspect-ratio: 4 / 5;
      max-height: 36rem;
    }
  }
</style>
