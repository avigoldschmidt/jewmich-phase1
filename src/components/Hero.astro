---
import CtaLink from './CtaLink.astro';
import { withBase } from '../lib/paths';

interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  sameTab?: boolean;
}

interface Props {
  brand: string;
  headline: string;
  sentence: string;
  imageSrc?: string;
  imageAlt?: string;
  ctas?: Cta[];
  tone?: 'students' | 'community';
}

const {
  brand,
  headline,
  sentence,
  imageSrc,
  imageAlt = '',
  ctas = [],
  tone = 'students',
} = Astro.props;

const resolvedImage = imageSrc ? withBase(imageSrc) : undefined;
---

<section class:list={['hero', `hero--${tone}`]} aria-label="Hero">
  <div class="hero__plane" aria-hidden={imageAlt ? undefined : 'true'}>
    {
      resolvedImage ? (
        <img
          class="hero__photo"
          src={resolvedImage}
          alt=""
          width="1920"
          height="1080"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <div class="hero__fallback"></div>
      )
    }
  </div>

  <div class="hero__rail">
    <div class="hero__rail-inner">
      <p class="hero__brand">{brand}</p>
      <h1 class="hero__headline">{headline}</h1>
      <p class="hero__sentence">{sentence}</p>
      {
        ctas.length > 0 && (
          <div class="cta-row hero__ctas">
            {ctas.map((cta, i) => (
              <CtaLink
                href={cta.href}
                label={cta.label}
                variant={cta.variant ?? (i === 0 ? 'primary' : 'secondary')}
                external={cta.external}
                sameTab={cta.sameTab ?? true}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
  {imageAlt && <span class="sr-only">{imageAlt}</span>}
</section>

<style>
  /*
    Full-bleed photographic plane + flush left brand rail.
    Solid paper for type — no muddy dark overlay, no floating card.
  */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
  }

  .hero__plane {
    position: relative;
    min-height: clamp(13rem, 42vw, 18rem);
    z-index: 0;
  }

  .hero__photo,
  .hero__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: hero-settle 1.25s var(--ease) both;
  }

  .hero--students .hero__photo {
    object-position: center 42%;
  }

  .hero--community .hero__photo {
    object-position: center 38%;
  }

  .hero__fallback {
    background: linear-gradient(155deg, #176087 0%, #07111d 72%);
    min-height: inherit;
  }

  .hero__rail {
    position: relative;
    z-index: 1;
    background: linear-gradient(165deg, #ffffff 0%, var(--paper) 70%, #e8eef5 100%);
    animation: fade-up 700ms var(--ease) both;
  }

  .hero--students .hero__rail {
    box-shadow: inset 4px 0 0 var(--color-maize);
  }

  .hero--community .hero__rail {
    box-shadow: inset 4px 0 0 var(--color-lake);
  }

  .hero__rail-inner {
    width: min(100% - 2rem, 28rem);
    margin-inline: auto;
    padding-block: clamp(1.75rem, 5vh, 2.75rem);
  }

  .hero__brand {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.55rem);
    font-weight: 600;
    font-optical-sizing: auto;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-ink);
  }

  .hero--students .hero__brand::after,
  .hero--community .hero__brand::after {
    content: '';
    display: block;
    width: 1.85rem;
    height: 3px;
    margin-top: 0.5rem;
  }

  .hero--students .hero__brand::after {
    background: var(--color-maize);
  }

  .hero--community .hero__brand::after {
    background: var(--color-lake);
  }

  .hero__headline {
    margin: 0 0 0.5rem;
    font-family: var(--font-ui);
    font-size: clamp(1.12rem, 1.9vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.012em;
    line-height: 1.28;
    color: var(--color-ink);
    max-width: 24rem;
  }

  .hero__sentence {
    margin: 0 0 1.25rem;
    max-width: 25rem;
    font-family: var(--font-ui);
    font-size: 0.98rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  @media (min-width: 900px) {
    .hero {
      min-height: min(78vh, 44rem);
      align-items: stretch;
    }

    .hero__plane {
      position: absolute;
      inset: 0;
      min-height: 100%;
    }

    .hero__rail {
      width: min(42vw, 36rem);
      min-height: 100%;
      display: flex;
      align-items: center;
    }

    .hero__rail-inner {
      width: min(100% - 3.5rem, 29rem);
      margin-inline: auto 0;
      padding-inline: clamp(1.75rem, 4vw, 3rem) 1.25rem;
      padding-block: clamp(3.5rem, 10vh, 5.5rem);
    }

    .hero--students .hero__photo {
      object-position: 68% 42%;
    }

    .hero--community .hero__photo {
      object-position: 62% 38%;
    }
  }
</style>
