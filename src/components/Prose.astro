---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: var(--prose-width);
    color: var(--color-ink);
    font-size: 1.05rem;
    line-height: 1.62;
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(> :last-child) {
    margin-bottom: 0;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 1.55rem 0 0.55rem;
    letter-spacing: -0.014em;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 0.9rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.15rem;
  }

  .prose :global(li) {
    margin-bottom: 0.3rem;
  }

  .prose :global(a) {
    color: var(--color-accent-text);
    text-decoration-color: rgba(26, 95, 138, 0.4);
  }

  .prose :global(blockquote) {
    margin: 1.15rem 0;
    padding: 0.15rem 0 0.15rem 0.9rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-muted);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 1.5rem 0;
  }
</style>
