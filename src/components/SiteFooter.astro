---
import AudienceSwitcher from './AudienceSwitcher.astro';
import type { Audience } from '../lib/nav';
import { SITE, SHARED_FOOTER_LINKS } from '../lib/nav';
import { withBase } from '../lib/paths';

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__utility">
    <div class="container site-footer__utility-inner">
      <span class="site-footer__util-item">{SITE.addressShort}</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <a class="site-footer__util-item" href={`tel:${SITE.phoneTel}`}
        >{SITE.phoneDisplay}</a
      >
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <a class="site-footer__util-item" href={withBase('/map')}>Map</a>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <a class="site-footer__util-item site-footer__util-donate" href={withBase('/donate')}
        >Donate</a
      >
      <span class="site-footer__sep site-footer__sep--switch" aria-hidden="true"
        >·</span
      >
      <div class="site-footer__utility-switcher">
        <AudienceSwitcher audience={audience} />
      </div>
    </div>
  </div>

  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <p class="site-footer__name">{SITE.name}</p>
      <p class="site-footer__address">
        {
          SITE.addressLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
      </p>
      <div class="site-footer__domains">
        <a href={SITE.domains.students}>JewMich.com</a>
        <span aria-hidden="true">·</span>
        <a href={SITE.domains.community}>ChabadAnnArbor.com</a>
      </div>
    </div>

    <nav class="site-footer__links" aria-label="Shared links">
      {
        SHARED_FOOTER_LINKS.map((item) => (
          <a href={withBase(item.href)}>{item.label}</a>
        ))
      }
    </nav>
  </div>

  <div class="site-footer__bar">
    <div class="container">
      <p>
        © {new Date().getFullYear()} {SITE.name}. One codebase · two homes.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--color-ink);
    color: rgba(251, 251, 250, 0.82);
  }

  .site-footer a {
    color: rgba(251, 251, 250, 0.9);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .site-footer__utility {
    border-bottom: 1px solid rgba(251, 251, 250, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .site-footer__utility-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.55rem;
    padding: 0.95rem 0;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-footer__util-item {
    color: rgba(251, 251, 250, 0.88);
  }

  .site-footer__util-donate {
    color: var(--color-accent) !important;
    font-weight: 650;
  }

  .site-footer__sep {
    color: rgba(251, 251, 250, 0.28);
    user-select: none;
  }

  .site-footer__utility-switcher {
    margin-left: 0.15rem;
  }

  .site-footer__utility-switcher :global(.audience-switcher__link) {
    color: rgba(251, 251, 250, 0.72);
  }

  .site-footer__utility-switcher :global(.audience-switcher__link:hover),
  .site-footer__utility-switcher :global(.audience-switcher__link.is-active) {
    color: #fff;
  }

  .site-footer__utility-switcher :global(.audience-switcher__sep) {
    color: rgba(251, 251, 250, 0.28);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .site-footer__name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 650;
    color: #fff;
  }

  .site-footer__address {
    margin: 0 0 0.85rem;
    line-height: 1.55;
    color: rgba(251, 251, 250, 0.7);
  }

  .site-footer__domains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 560;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1rem;
    align-content: start;
    font-size: 0.95rem;
  }

  .site-footer__bar {
    border-top: 1px solid rgba(251, 251, 250, 0.1);
    padding: 0.85rem 0 1.1rem;
    font-size: 0.88rem;
    color: rgba(251, 251, 250, 0.45);
  }

  .site-footer__bar p {
    margin: 0;
  }

  @media (min-width: 800px) {
    .site-footer__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: 2rem;
    }

    .site-footer__links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
