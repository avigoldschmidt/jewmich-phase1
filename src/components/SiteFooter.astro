---
import AudienceSwitcher from './AudienceSwitcher.astro';
import type { Audience } from '../lib/nav';
import { SITE, FOOTER_GROUPS } from '../lib/nav';
import { withBase } from '../lib/paths';

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <p class="site-footer__name">{SITE.name}</p>
      <p class="site-footer__address">
        {
          SITE.addressLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
      </p>
      <p class="site-footer__phone">
        <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
      </p>
      <p class="site-footer__since">Since {SITE.since}</p>
      {
        SITE.ein ? (
          <p class="site-footer__ein">EIN {SITE.ein}</p>
        ) : null
      }
      <div class="site-footer__domains">
        <a href={SITE.domains.students}>JewMich.com</a>
        <span aria-hidden="true">·</span>
        <a href={SITE.domains.community}>ChabadAnnArbor.com</a>
      </div>
      <div class="site-footer__switcher">
        <AudienceSwitcher audience={audience} compact />
      </div>
    </div>

    <div class="site-footer__groups">
      {
        FOOTER_GROUPS.map((group) => (
          <nav class="site-footer__group" aria-label={group.heading}>
            <h2 class="site-footer__group-heading">{group.heading}</h2>
            <ul>
              {group.links.map((item) => (
                <li>
                  <a href={withBase(item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="site-footer__bar">
    <div class="container">
      <p>
        © {new Date().getFullYear()} {SITE.name}. One House · two homes.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--color-night);
    color: rgba(246, 248, 251, 0.72);
  }

  .site-footer a {
    color: rgba(246, 248, 251, 0.88);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-10);
    padding: var(--space-xl) 0 var(--space-8);
  }

  .site-footer__name {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #fff;
  }

  .site-footer__address,
  .site-footer__phone,
  .site-footer__since,
  .site-footer__ein {
    margin: 0 0 0.45rem;
    line-height: 1.5;
    color: rgba(246, 248, 251, 0.62);
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .site-footer__domains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0.85rem 0;
  }

  .site-footer__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .site-footer__group {
    margin: 0;
  }

  .site-footer__group-heading {
    margin: 0 0 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(246, 248, 251, 0.45);
  }

  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .site-footer__bar {
    border-top: 1px solid rgba(246, 248, 251, 0.08);
    padding: 0.75rem 0 1rem;
    font-size: 0.84rem;
    font-family: var(--font-ui);
    color: rgba(246, 248, 251, 0.4);
  }

  .site-footer__bar p {
    margin: 0;
  }

  @media (min-width: 800px) {
    .site-footer__inner {
      grid-template-columns: 1.05fr 1.45fr;
      gap: 2rem;
    }

    .site-footer__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
