---
import AudienceSwitcher from './AudienceSwitcher.astro';
import type { Audience } from '../lib/nav';
import {
  SITE,
  navForAudience,
  homeForAudience,
  primaryMobileLink,
} from '../lib/nav';
import { withBase } from '../lib/paths';

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const nav = navForAudience(audience);
const homeHref = withBase(homeForAudience(audience));
const isStudent = !(audience === 'community' || audience === 'youth');
const brand = isStudent ? SITE.studentBrand : SITE.communityBrand;
const mobilePrimary = primaryMobileLink(audience);
const menuId = 'site-primary-menu';
---

<header class:list={['site-header', isStudent ? 'site-header--students' : 'site-header--community']}>
  <div class="site-header__inner container">
    <div class="site-header__bar">
      <a class="site-header__brand" href={homeHref}>
        <span class="site-header__mark" aria-hidden="true">
          <svg viewBox="0 0 32 40" width="22" height="28" fill="none">
            <path
              d="M16 2c2.8 5.2 9 9.4 9 17.2C25 27 21 34 16 38c-5-4-9-11-9-18.8C7 11.4 13.2 7.2 16 2Z"
              fill={isStudent ? '#1A5F8A' : '#0E4266'}
            ></path>
            <path
              d="M16 8c1.5 3.1 5 5.5 5 10.1 0 5.3-2.2 9.3-5 11.9-2.8-2.6-5-6.6-5-11.9 0-4.6 3.5-7 5-10.1Z"
              fill="#FFCB05"
              opacity={isStudent ? '0.92' : '0.55'}
            ></path>
          </svg>
        </span>
        <span class="site-header__names">
          <span class="site-header__brand-name">{brand}</span>
          <span class="site-header__house">{SITE.name}</span>
        </span>
      </a>

      <div class="site-header__desktop-switcher">
        <AudienceSwitcher audience={audience} tone="light" />
      </div>

      <nav class="site-header__nav site-header__nav--desktop" aria-label="Primary">
        {
          nav.map((item) => (
            <a href={withBase(item.href)}>{item.label}</a>
          ))
        }
      </nav>

      <div class="site-header__actions">
        <a class="site-header__donate" href={withBase('/donate')}>Donate</a>
        <button
          class="site-header__menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls={menuId}
          data-menu-toggle
        >
          <span data-menu-label>Menu</span>
        </button>
      </div>
    </div>

    <div class="site-header__mobile-switcher">
      <AudienceSwitcher audience={audience} tone="light" />
    </div>

    <div class="site-header__panel" id={menuId} hidden>
      <a
        class="site-header__panel-primary"
        href={withBase(mobilePrimary.href)}
      >
        {mobilePrimary.label}
      </a>
      <nav class="site-header__nav site-header__nav--mobile" aria-label="Primary">
        {
          nav
            .filter((item) => item.href !== mobilePrimary.href)
            .map((item) => (
              <a href={withBase(item.href)}>{item.label}</a>
            ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector('[data-menu-toggle]');
  const panel = document.getElementById('site-primary-menu');
  const label = document.querySelector('[data-menu-label]');
  if (btn && panel && label) {
    const setOpen = (open) => {
      panel.hidden = !open;
      panel.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      label.textContent = open ? 'Close' : 'Menu';
    };

    btn.addEventListener('click', () => {
      setOpen(panel.hidden);
    });

    panel.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>

<style>
  /* One chrome bar — no dark utility strip stacked above white nav */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.96);
    color: var(--color-ink);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .site-header--students {
    border-top: 3px solid var(--color-maize);
  }

  .site-header--community {
    border-top: 3px solid var(--color-lake);
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-block: 0.45rem 0.55rem;
  }

  .site-header__bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    min-height: calc(var(--header-height) - 0.5rem);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    min-width: 0;
    margin-right: auto;
  }

  .site-header__brand:hover {
    color: inherit;
  }

  .site-header__mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
  }

  .site-header__names {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.12;
  }

  .site-header__brand-name {
    font-family: var(--font-display);
    font-size: 1.14rem;
    font-weight: 600;
    letter-spacing: -0.022em;
  }

  .site-header__house {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-header__desktop-switcher {
    display: none;
  }

  .site-header__mobile-switcher {
    display: block;
    width: 100%;
    padding-top: 0.45rem;
  }

  .site-header__mobile-switcher :global(.audience-switcher) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    font-size: 0.95rem;
  }

  .site-header__mobile-switcher :global(.audience-switcher__link) {
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.55rem 0.75rem;
    font-weight: 700;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.05rem;
    align-items: center;
  }

  .site-header__nav--desktop {
    display: none;
  }

  .site-header__nav a {
    position: relative;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.45rem 0;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 2px;
    background: var(--color-maize);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease);
  }

  .site-header--community .site-header__nav a::after {
    background: var(--color-lake);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-ink);
  }

  .site-header__nav a:hover::after,
  .site-header__nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 0 auto;
  }

  .site-header__donate,
  .site-header__menu-btn {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
    height: 2.6rem;
    min-height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .site-header__donate {
    background: var(--color-ink);
    color: var(--color-on-photo) !important;
    padding: 0 0.9rem;
    border-radius: var(--radius);
  }

  .site-header__donate:hover {
    background: var(--color-lake-deep);
    color: #fff !important;
  }

  .site-header__menu-btn {
    appearance: none;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--color-ink);
    border-radius: var(--radius);
    padding: 0 0.85rem;
    cursor: pointer;
    min-width: 4.5rem;
  }

  .site-header__menu-btn[aria-expanded='true'] {
    background: var(--mist);
    border-color: var(--color-ink);
  }

  .site-header__panel {
    display: none;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    padding-top: 0.65rem;
    margin-top: 0.55rem;
    border-top: 1px solid var(--line);
  }

  .site-header__panel.is-open {
    display: flex;
  }

  .site-header__panel-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    margin-bottom: 0.25rem;
    border-radius: var(--radius);
    background: var(--color-ink);
    color: #fff !important;
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header--students .site-header__panel-primary {
    background: var(--color-ink);
    box-shadow: inset 0 -3px 0 var(--color-maize);
  }

  .site-header--community .site-header__panel-primary {
    background: var(--color-lake-deep);
  }

  .site-header__nav--mobile {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .site-header__nav--mobile a {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.15rem;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--color-ink);
    border-bottom: 1px solid var(--line);
  }

  .site-header__nav--mobile a::after {
    display: none;
  }

  @media (max-width: 640px) {
    .site-header__brand-name {
      font-size: 1.08rem;
    }

    .site-header__house {
      max-width: 9.5rem;
    }
  }

  @media (min-width: 980px) {
    .site-header__inner {
      padding-block: 0.45rem;
    }

    .site-header__bar {
      gap: 1rem 1.25rem;
      min-height: var(--header-height);
    }

    .site-header__desktop-switcher {
      display: block;
      flex: 0 0 auto;
    }

    .site-header__mobile-switcher,
    .site-header__menu-btn,
    .site-header__panel {
      display: none !important;
    }

    .site-header__nav--desktop {
      display: flex;
      flex: 1;
      justify-content: center;
      width: auto;
    }

    .site-header__brand {
      margin-right: 0;
    }

    .site-header__brand-name {
      font-size: 1.24rem;
    }

    .site-header__actions {
      gap: 0.55rem;
      margin-left: auto;
    }

    .site-header__donate {
      height: var(--control-height);
      min-height: var(--control-height);
      padding: 0 1.1rem;
      font-size: 0.95rem;
    }
  }
</style>
