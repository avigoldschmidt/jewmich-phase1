---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageMeta from '../components/PageMeta.astro';
import type { Audience } from '../lib/nav';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  audience: Audience;
  canonicalPath?: string;
}

const { title, description, audience, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Source+Serif+4:opsz,wght@8..60,400..650&display=swap"
      rel="stylesheet"
    />
    <PageMeta
      title={title}
      description={description}
      canonicalPath={canonicalPath}
    />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader audience={audience} />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter audience={audience} />
    </div>
  </body>
</html>
