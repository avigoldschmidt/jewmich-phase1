---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageMeta from '../components/PageMeta.astro';
import type { Audience } from '../lib/nav';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  audience: Audience;
  canonicalPath?: string;
}

const { title, description, audience, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <PageMeta
      title={title}
      description={description}
      canonicalPath={canonicalPath}
    />
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader audience={audience} />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter audience={audience} />
    </div>
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        nodes.forEach((el) => el.classList.add('is-visible'));
      } else {
        document.documentElement.classList.add('js-motion');
        // Mark anything already in (or near) the first viewport as visible
        // so peeks below the hero never render as washed-out gray.
        const vh = window.innerHeight || 800;
        nodes.forEach((el) => {
          const top = (el as HTMLElement).getBoundingClientRect().top;
          if (top < vh * 0.92) el.classList.add('is-visible');
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        nodes.forEach((el) => {
          if (!el.classList.contains('is-visible')) io.observe(el);
        });
      }
    </script>
  </body>
</html>
