---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import CtaLink from '../components/CtaLink.astro';
import ActionPanel from '../components/ActionPanel.astro';
import type { Audience } from '../lib/nav';
import type { ActionId } from '../data/actions';

interface Registration {
  type: 'url' | 'embed';
  href: string;
  label?: string;
}

interface Props {
  title: string;
  description: string;
  audience: Audience;
  registration?: Registration;
  actions?: string[];
  canonicalPath?: string;
}

const { title, description, audience, registration, actions = [], canonicalPath } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  audience={audience}
  canonicalPath={canonicalPath}
>
  <section class="section">
    <div class="container content-page">
      <header class="content-page__header">
        <h1 class="content-page__title">{title}</h1>
        <p class="content-page__desc">{description}</p>
        {
          actions.length > 0 ? (
            <ActionPanel id={actions[0] as ActionId} />
          ) : registration?.type === 'url' ? (
            <div class="cta-row">
              <CtaLink
                href={registration.href}
                label={registration.label ?? 'Register'}
                variant="primary"
                sameTab
              />
              <p class="content-page__form-note">Opens our registration form</p>
            </div>
          ) : null
        }
      </header>
      <Prose>
        <slot />
      </Prose>
      {
        actions.length > 1 &&
          actions.slice(1).map((id) => <ActionPanel id={id as ActionId} />)
      }
      <slot name="after" />
    </div>
  </section>
</BaseLayout>

<style>
  .content-page__header {
    margin-bottom: var(--space-lg);
    max-width: 42rem;
  }

  .content-page__title {
    margin: 0 0 0.55rem;
    font-size: clamp(2rem, 4vw, 2.7rem);
  }

  .content-page__desc {
    margin: 0 0 1.1rem;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .content-page__form-note {
    margin: 0;
    width: 100%;
    color: var(--color-muted);
    font-size: 0.92rem;
  }
</style>
