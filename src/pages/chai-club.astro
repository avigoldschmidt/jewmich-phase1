---
import ContentPage from '../layouts/ContentPage.astro';
import { loadPage } from '../lib/content';

const { entry, Content } = await loadPage('shared', 'chai-club');
const { title, description, audience, registration } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  registration={registration}
  canonicalPath="/chai-club"
>
  <Content />
  <p class="flag-note">
    Staff follow-up: confirm Chai Club vs membership wording before launch
    messaging hardens.
  </p>
</ContentPage>
