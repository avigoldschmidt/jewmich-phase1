---
import ContentPage from '../../layouts/ContentPage.astro';
import { loadPage } from '../../lib/content';

const { entry, Content } = await loadPage('community', 'high-holidays');
const { title, description, audience, registration } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  registration={registration}
  canonicalPath="/community/high-holidays"
>
  <Content />
  <p class="flag-note">
    Staff follow-up: community vs student High Holiday times still disagree on
    legacy pages — confirm before listing times here.
  </p>
</ContentPage>
