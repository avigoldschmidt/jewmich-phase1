---
import ContentPage from '../../layouts/ContentPage.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import { loadPage } from '../../lib/content';

const { entry, Content } = await loadPage('community', 'holidays');
const { title, description, audience, actions } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  actions={actions?.slice(0, 1)}
  canonicalPath="/community/holidays"
>
  <Content />
  <Fragment slot="after">
    <ActionPanel id="sell-chometz" heading="Sell chometz" />
    <ActionPanel id="sell-chometz-cc" heading="Sell chometz (card)" />
    <ActionPanel id="lulav-set" heading="Lulav and etrog" />
    <ActionPanel id="community-passover-seder" heading="Community Passover seder" />
  </Fragment>
</ContentPage>
