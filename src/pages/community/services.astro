---
import ContentPage from '../../layouts/ContentPage.astro';
import CtaLink from '../../components/CtaLink.astro';
import { loadPage } from '../../lib/content';

const { entry, Content } = await loadPage('community', 'services');
const { title, description, audience, registration } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  registration={registration}
  canonicalPath="/community/services"
>
  <Content />
  <div class="cta-row" style="margin-top: 1.25rem;">
    <CtaLink href="/contact" label="Contact us for current times" variant="primary" />
  </div>
  <p class="flag-note">
    No invented prayer times in Phase 1 — schedule awaits staff confirmation.
  </p>
</ContentPage>
