---
import ContentPage from '../layouts/ContentPage.astro';
import { loadPage } from '../lib/content';

const { entry, Content } = await loadPage('shared', 'contact');
const { title, description, audience, actions } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  actions={actions}
  canonicalPath="/contact"
>
  <Content />
</ContentPage>
