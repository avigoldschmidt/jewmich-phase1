---
import ContentPage from '../layouts/ContentPage.astro';
import DonateMethods from '../components/DonateMethods.astro';
import { loadPage } from '../lib/content';

const { entry, Content } = await loadPage('shared', 'donate');
const { title, description, audience } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  canonicalPath="/donate"
>
  <Content />
  <Fragment slot="after">
    <div style="margin-top: 2rem;">
      <DonateMethods />
    </div>
  </Fragment>
</ContentPage>
