---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Notice from '../../components/Notice.astro';
import TaskList from '../../components/TaskList.astro';
import EventList from '../../components/EventList.astro';
import CtaLink from '../../components/CtaLink.astro';
import { getCollection } from 'astro:content';
import { loadPage } from '../../lib/content';
import { SITE } from '../../lib/nav';
import { withBase } from '../../lib/paths';

const { entry } = await loadPage('home', 'community');
const { title, description, hero, notice, tasks } = entry.data;

const events = (await getCollection('events')).filter(
  (e) => !e.data.draft && (e.data.audience === 'community' || e.data.audience === 'both'),
);
---

<BaseLayout
  title={`${SITE.communityBrand} · ${SITE.name}`}
  description={description}
  audience="community"
  canonicalPath="/home/community"
>
  <Hero
    tone="community"
    brand={SITE.communityBrand}
    headline={hero?.headline ?? title}
    sentence={hero?.sentence ?? description}
    imageSrc={hero?.image ?? '/images/heroes/community-wide.jpg'}
    imageAlt={hero?.imageAlt ?? 'Chabad House of Ann Arbor at 715 Hill Street'}
    ctas={[
      {
        href: hero?.primaryCta?.href ?? '/visit',
        label: hero?.primaryCta?.label ?? 'Plan your visit',
        variant: 'primary',
      },
      {
        href: hero?.secondaryCta?.href ?? '/community/services',
        label: hero?.secondaryCta?.label ?? 'Service times',
        variant: 'secondary',
      },
    ]}
  />

  <Notice notice={notice} />

  <section class="section" data-reveal>
    <div class="container">
      <h2 class="section-heading">Find your place</h2>
      <p class="section-lede">Five ways into community life at the House.</p>
      {tasks && <TaskList tasks={tasks} />}
    </div>
  </section>

  <section class="section section--mist" data-reveal>
    <div class="container">
      <h2 class="section-heading">What's on</h2>
      <p class="section-lede">Current community sign-ups and seasonal programs.</p>
      <EventList events={events} />
      <div class="cta-row" style="margin-top: 1.25rem;">
        <CtaLink href="/events" label="All events" variant="secondary" />
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <h2 class="section-heading">Who we are</h2>
      <p class="section-lede">
        Since {SITE.since}, Chabad House of Ann Arbor has served students and
        local residents together — services, meals, learning, and a listening ear.
      </p>
      <p>
        <!-- staff: add rabbi and rebbetzin names and photos -->
        <a href={withBase('/about')}>About the House</a>
      </p>
    </div>
  </section>

  <section class="section section--mist" data-reveal>
    <div class="container">
      <h2 class="section-heading">Belong &amp; support</h2>
      <p class="section-lede">
        Three clear options — membership, monthly giving, and one-time gifts are
        different paths.
      </p>
      <ul class="belong">
        <li>
          <h3>Membership</h3>
          <p>For the congregation community.</p>
          <CtaLink
            href="https://www.jewmich.com/membership/"
            label="Membership"
            variant="secondary"
            sameTab
          />
        </li>
        <li>
          <h3>Chai Club</h3>
          <p>Monthly support — separate from membership.</p>
          <CtaLink href="/donate#chai-club" label="Chai Club" variant="secondary" />
        </li>
        <li>
          <h3>Donate</h3>
          <p>One-time gifts that keep programs running.</p>
          <CtaLink href="/donate" label="Donate" variant="primary" />
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .belong {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    max-width: 46rem;
  }

  .belong h3 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
    letter-spacing: -0.012em;
  }

  .belong p {
    margin: 0 0 0.7rem;
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  @media (min-width: 800px) {
    .belong {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6) var(--space-8);
    }
  }
</style>
