---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Notice from '../../components/Notice.astro';
import TaskList from '../../components/TaskList.astro';
import EventList from '../../components/EventList.astro';
import CtaLink from '../../components/CtaLink.astro';
import { getCollection } from 'astro:content';
import { loadPage } from '../../lib/content';
import { SITE } from '../../lib/nav';
import { withBase } from '../../lib/paths';

const { entry } = await loadPage('home', 'community');
const { title, description, hero, notice, tasks } = entry.data;

const events = (await getCollection('events')).filter(
  (e) => !e.data.draft && (e.data.audience === 'community' || e.data.audience === 'both'),
);
---

<BaseLayout
  title={`${SITE.communityBrand} · ${SITE.name}`}
  description={description}
  audience="community"
  canonicalPath="/home/community"
>
  <Hero
    tone="community"
    brand={SITE.communityBrand}
    headline={hero?.headline ?? title}
    sentence={hero?.sentence ?? description}
    imageSrc={hero?.image ?? '/images/heroes/community-wide.jpg'}
    imageAlt={hero?.imageAlt ?? 'Chabad House of Ann Arbor at 715 Hill Street'}
    ctas={[
      {
        href: hero?.primaryCta?.href ?? '/visit',
        label: hero?.primaryCta?.label ?? 'Plan your visit',
        variant: 'primary',
      },
      {
        href: hero?.secondaryCta?.href ?? '/community/services',
        label: hero?.secondaryCta?.label ?? 'Service times',
        variant: 'secondary',
      },
    ]}
  />

  <Notice notice={notice} />

  {/* One job: orient */}
  <section class="section go" data-reveal>
    <div class="container go__grid">
      <div class="go__intro">
        <h2 class="section-heading">Where to go</h2>
        <p class="section-lede">
          Services, holidays, learning, youth, and the House — one tap each.
        </p>
      </div>
      <div class="go__list">
        {tasks && <TaskList tasks={tasks} />}
      </div>
    </div>
  </section>

  {/* One job: current sign-ups */}
  <section class="section section--mist" data-reveal>
    <div class="container">
      <h2 class="section-heading">What's on</h2>
      <p class="section-lede">
        Current community sign-ups. For service times,
        <a href={withBase('/contact')}>contact us</a> until staff confirm a
        published schedule.
      </p>
      <EventList events={events} />
      <div class="cta-row" style="margin-top: 1.25rem;">
        <CtaLink href="/events" label="All events" variant="secondary" />
      </div>
    </div>
  </section>

  {/* One job: trust — full story on About */}
  <section class="section" data-reveal>
    <div class="container trust">
      <p class="trust__since">Since {SITE.since} · 715 Hill Street</p>
      <h2 class="section-heading">Who we are</h2>
      <p class="section-lede">
        Chabad House of Ann Arbor is a Jewish community center in the truest sense —
        congregation life, learning, Hebrew School, and the student table under one
        roof. Programming follows Chabad-Lubavitch; each local center is supported by
        the community it serves.
      </p>
      <div class="cta-row">
        <CtaLink href="/about" label="About the House" variant="secondary" />
        <CtaLink href="/community/jewish-life" label="Jewish life resources" variant="text" />
      </div>
    </div>
  </section>

  {/* One job: belong / give — soft Chai Club ≠ membership */}
  <section class="section section--mist" data-reveal>
    <div class="container">
      <h2 class="section-heading">Belong &amp; support</h2>
      <p class="section-lede">
        Membership, monthly giving, and one-time gifts are different paths. Chai Club
        is monthly support — separate from congregation membership.
      </p>
      <ul class="belong">
        <li>
          <h3>Membership</h3>
          <p>For the congregation community at Chabad House.</p>
          <CtaLink
            href="https://www.jewmich.com/membership/"
            label="Membership"
            variant="secondary"
            sameTab
          />
        </li>
        <li>
          <h3>Chai Club</h3>
          <p>Monthly support that helps keep programs and the open door going.</p>
          <CtaLink href="/donate#chai-club" label="Chai Club" variant="secondary" />
        </li>
        <li>
          <h3>Donate</h3>
          <p>One-time gifts, kiddush sponsorships, Life &amp; Legacy, and more.</p>
          <CtaLink href="/donate" label="Donate" variant="primary" />
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .go__grid {
    display: grid;
    gap: var(--space-6);
  }

  .go__intro .section-lede {
    margin-bottom: 0;
  }

  @media (min-width: 900px) {
    .go__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .trust {
    max-width: 40rem;
  }

  .trust__since {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-lake-deep);
  }

  .belong {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    max-width: 46rem;
  }

  .belong h3 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
    letter-spacing: -0.012em;
  }

  .belong p {
    margin: 0 0 0.7rem;
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  @media (min-width: 800px) {
    .belong {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6) var(--space-8);
    }
  }
</style>
