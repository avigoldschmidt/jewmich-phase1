---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Prose from '../../components/Prose.astro';
import CtaLink from '../../components/CtaLink.astro';
import { loadPage } from '../../lib/content';
import { SITE } from '../../lib/nav';

const { entry, Content } = await loadPage('home', 'community');
const { title, description, heroImage } = entry.data;
---

<BaseLayout
  title={`${SITE.communityBrand} · ${SITE.name}`}
  description={description}
  audience="community"
  canonicalPath="/home/community"
>
  <Hero
    brand={SITE.communityBrand}
    headline={title}
    sentence="Services, holidays, and Jewish life for families and neighbors across Ann Arbor."
    imageSrc={heroImage ?? '/images/hero-community.svg'}
    imageAlt="Community gathering placeholder — replace with real Chabad Ann Arbor photos"
    tone="community"
    ctas={[
      {
        href: '/community/services',
        label: 'Services',
        variant: 'primary',
        external: false,
      },
      {
        href: '/youth',
        label: 'Youth / CHS',
        variant: 'secondary',
        external: false,
      },
    ]}
    placeholderNote="Placeholder hero until staff supply real community gathering photos."
  />

  <section class="section">
    <div class="container home-grid">
      <div>
        <h2 class="section-heading">Welcome to Congregation Chabad</h2>
        <p class="section-lede">
          Pray, celebrate, and learn with a community that feels like family —
          right at 715 Hill Street.
        </p>
        <Prose>
          <Content />
        </Prose>
      </div>
      <div class="cta-row home-grid__actions">
        <CtaLink
          href="/community/high-holidays"
          label="High Holidays"
          variant="primary"
        />
        <CtaLink href="/events" label="Events" variant="secondary" />
        <CtaLink href="/membership" label="Membership" variant="secondary" />
        <CtaLink href="/donate" label="Donate" variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 800px) {
    .home-grid {
      grid-template-columns: 1.4fr 0.8fr;
      align-items: start;
    }

    .home-grid__actions {
      flex-direction: column;
      align-items: stretch;
      padding-top: 2.4rem;
    }
  }
</style>
