---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Prose from '../../components/Prose.astro';
import CtaLink from '../../components/CtaLink.astro';
import { loadPage } from '../../lib/content';
import { SITE } from '../../lib/nav';

const { entry, Content } = await loadPage('home', 'community');
const { title, description, heroImage } = entry.data;
---

<BaseLayout
  title={`${SITE.communityBrand} · ${SITE.name}`}
  description={description}
  audience="community"
  canonicalPath="/home/community"
>
  <Hero
    brand={SITE.communityBrand}
    headline={title}
    sentence="Services, holidays, and Jewish life for families and neighbors across Ann Arbor."
    imageSrc={heroImage ?? '/images/hero-community.svg'}
    imageAlt="Community gathering placeholder — replace with real Chabad Ann Arbor photos"
    tone="community"
    ctas={[
      {
        href: '/visit',
        label: 'Plan a visit',
        variant: 'primary',
        external: false,
      },
      {
        href: '/community/services',
        label: 'Services',
        variant: 'secondary',
        external: false,
      },
    ]}
  />

  <section class="section" data-reveal>
    <div class="container">
      <h2 class="section-heading">Visit &amp; services</h2>
      <p class="section-lede">
        Pray, celebrate, and learn with a community that feels like family —
        right at 715 Hill Street.
      </p>
      <div class="home-block">
        <Prose>
          <Content />
        </Prose>
        <div class="cta-row home-block__actions">
          <CtaLink href="/visit" label="Visit" variant="primary" />
          <CtaLink href="/community/services" label="Services" variant="secondary" />
          <CtaLink
            href="/community/high-holidays"
            label="Holidays"
            variant="secondary"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--youth" data-reveal>
    <div class="container youth-block">
      <div>
        <h2 class="section-heading">Youth</h2>
        <p class="section-lede">
          Chabad Hebrew School and programs for kids and teens — a warm path
          into Jewish life.
        </p>
      </div>
      <CtaLink href="/youth" label="Explore youth / CHS" variant="secondary" />
    </div>
  </section>

  <section class="section section--give" data-reveal>
    <div class="container give-strip">
      <div>
        <h2 class="section-heading">Give</h2>
        <p class="section-lede give-strip__lede">
          Your support sustains services, youth, and a house open to Ann Arbor.
        </p>
      </div>
      <div class="cta-row">
        <CtaLink href="/donate" label="Donate" variant="primary" />
        <CtaLink href="/membership" label="Membership" variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-block {
    display: grid;
    gap: var(--space-lg);
  }

  .section--youth {
    background: var(--color-elevated);
    border-block: 1px solid rgba(14, 15, 18, 0.06);
  }

  .youth-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .youth-block .section-lede {
    margin-bottom: 0;
  }

  .section--give {
    padding-block: var(--space-lg);
  }

  .give-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(14, 15, 18, 0.08);
  }

  .give-strip .section-heading {
    margin-bottom: 0.35rem;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }

  .give-strip__lede {
    margin: 0;
  }

  @media (min-width: 800px) {
    .home-block {
      grid-template-columns: 1.5fr auto;
      align-items: start;
    }

    .home-block__actions {
      flex-direction: column;
      align-items: stretch;
      padding-top: 0.25rem;
    }
  }
</style>
