---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Notice from '../../components/Notice.astro';
import TaskList from '../../components/TaskList.astro';
import EventList from '../../components/EventList.astro';
import CtaLink from '../../components/CtaLink.astro';
import { getCollection } from 'astro:content';
import { loadPage } from '../../lib/content';
import { SITE } from '../../lib/nav';
import { withBase } from '../../lib/paths';

const { entry } = await loadPage('home', 'students');
const { title, description, hero, notice, tasks } = entry.data;

const events = (await getCollection('events')).filter(
  (e) => !e.data.draft && (e.data.audience === 'students' || e.data.audience === 'both'),
);
---

<BaseLayout
  title={`${SITE.studentBrand} · ${SITE.name}`}
  description={description}
  audience="students"
  canonicalPath="/home/students"
>
  <Hero
    tone="students"
    brand={SITE.studentBrand}
    headline={hero?.headline ?? title}
    sentence={hero?.sentence ?? description}
    imageSrc={hero?.image ?? '/images/heroes/students.jpg'}
    imageAlt={hero?.imageAlt ?? 'Fresh challah for Shabbat dinner at Chabad House'}
    ctas={[
      {
        href: hero?.primaryCta?.href ?? 'https://www.jewmich.com/shabbat/',
        label: hero?.primaryCta?.label ?? 'Reserve Shabbat dinner',
        variant: 'primary',
        sameTab: true,
      },
      {
        href: hero?.secondaryCta?.href ?? '/visit',
        label: hero?.secondaryCta?.label ?? 'Find us',
        variant: 'secondary',
      },
    ]}
  />

  <Notice notice={notice} />

  {/* One job: orient — destinations only; detail lives on each page */}
  <section class="section go" data-reveal>
    <div class="container go__grid">
      <div class="go__intro">
        <h2 class="section-heading">Where to go</h2>
        <p class="section-lede">
          Shabbat, holidays, learning, and the House — one tap each.
        </p>
      </div>
      <div class="go__list">
        {tasks && <TaskList tasks={tasks} />}
      </div>
    </div>
  </section>

  {/* One job: current sign-ups */}
  <section class="section section--mist" data-reveal>
    <div class="container">
      <h2 class="section-heading">What's on</h2>
      <p class="section-lede">
        Current student sign-ups. Shabbat dinner is every Friday of the semester —
        reserve on the live form for this week’s times.
      </p>
      <EventList events={events} />
      <div class="cta-row" style="margin-top: 1.25rem;">
        <CtaLink href="/events" label="All events" variant="secondary" />
      </div>
    </div>
  </section>

  {/* One job: trust + parents path — substance on About / Parents */}
  <section class="section" data-reveal>
    <div class="container trust">
      <p class="trust__since">Since {SITE.since} at 715 Hill Street</p>
      <p class="trust__body">
        JewMich is the student home of Chabad House of Ann Arbor — a family-style
        table for University of Michigan students of every background and every
        level of observance. Led by the Chabad Rabbi and Rebbetzin
        {/* staff: add names and photos */}. Deep story on
        <a href={withBase('/about')}>About</a>.
      </p>
      <div class="cta-row trust__ctas">
        <CtaLink href="/students/parents" label="For parents" variant="secondary" />
        <CtaLink
          href="https://www.jewmich.com/sponsorshabbat/"
          label="Sponsor a Shabbat"
          variant="text"
          sameTab
        />
        <CtaLink href="/students/trips" label="Birthright & trips" variant="text" />
      </div>
    </div>
  </section>

  {/* One job: give */}
  <section class="section section--mist" data-reveal>
    <div class="container give-band">
      <div>
        <h2 class="section-heading">Give</h2>
        <p class="section-lede">
          Gifts fund Shabbat dinners, holidays, learning, and the open door.
          Chabad is not centrally funded — local gifts stay local.
        </p>
      </div>
      <div class="cta-row">
        <CtaLink href="/donate" label="Donate" variant="primary" />
        <CtaLink href="/donate#chai-club" label="Chai Club" variant="text" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .go__grid {
    display: grid;
    gap: var(--space-6);
  }

  .go__intro .section-lede {
    margin-bottom: 0;
  }

  @media (min-width: 900px) {
    .go__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .trust {
    max-width: 40rem;
  }

  .trust__since {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-lake-deep);
  }

  .trust__body {
    margin: 0 0 var(--space-5);
    color: var(--color-ink-soft);
    font-family: var(--font-ui);
    font-size: 1rem;
    line-height: 1.55;
  }

  .trust__ctas {
    margin-top: var(--space-2);
  }

  .give-band {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5) var(--space-8);
  }

  .give-band .section-heading {
    margin-bottom: 0.3rem;
  }

  .give-band .section-lede {
    margin-bottom: 0;
  }
</style>
