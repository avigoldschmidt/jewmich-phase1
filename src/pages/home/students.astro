---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Prose from '../../components/Prose.astro';
import CtaLink from '../../components/CtaLink.astro';
import { loadPage } from '../../lib/content';
import { SITE } from '../../lib/nav';

const { entry, Content } = await loadPage('home', 'students');
const { title, description, heroImage } = entry.data;
---

<BaseLayout
  title={`${SITE.studentBrand} · ${SITE.name}`}
  description={description}
  audience="students"
  canonicalPath="/home/students"
>
  <Hero
    brand={SITE.studentBrand}
    headline={title}
    sentence="Shabbat dinner, friendship, and Jewish life for University of Michigan students — your home away from home."
    imageSrc={heroImage ?? '/images/hero-students.svg'}
    imageAlt="Students gathering at Chabad House — replace with authentic JHP photo when available"
    tone="students"
    ctas={[
      {
        href: 'https://www.jewmich.com/shabbat/',
        label: 'Reserve Shabbat',
        variant: 'maize',
      },
      {
        href: '/students/high-holidays',
        label: 'High Holidays',
        variant: 'secondary',
        external: false,
      },
    ]}
    placeholderNote="Staff: swap hero art for an authentic student gathering photo (do not alter faces)."
  />

  <section class="section">
    <div class="container home-grid">
      <div>
        <h2 class="section-heading">This week at JewMich</h2>
        <p class="section-lede">
          Start with Shabbat. Stay for learning, holidays, and a community that
          knows your name.
        </p>
        <Prose>
          <Content />
        </Prose>
      </div>
      <div class="cta-row home-grid__actions">
        <CtaLink href="/students/shabbat" label="Shabbat" variant="primary" />
        <CtaLink href="/students/learn" label="Learn" variant="secondary" />
        <CtaLink href="/visit" label="Visit" variant="secondary" />
        <CtaLink href="/donate" label="Donate" variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 800px) {
    .home-grid {
      grid-template-columns: 1.4fr 0.8fr;
      align-items: start;
    }

    .home-grid__actions {
      flex-direction: column;
      align-items: stretch;
      padding-top: 2.4rem;
    }
  }
</style>
