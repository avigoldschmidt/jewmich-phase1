---
import ContentPage from '../layouts/ContentPage.astro';
import { loadPage } from '../lib/content';

const { entry, Content } = await loadPage('shared', 'life-and-legacy');
const { title, description, audience, registration } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  registration={registration}
  canonicalPath="/life-and-legacy"
>
  <Content />
</ContentPage>
