---
import ContentPage from '../layouts/ContentPage.astro';
import { loadPage } from '../lib/content';

const { entry, Content } = await loadPage('shared', 'myth-and-fact');
const { title, description, audience } = entry.data;
---

<ContentPage title={title} description={description} audience={audience} canonicalPath="/myth-and-fact">
  <Content />
</ContentPage>
