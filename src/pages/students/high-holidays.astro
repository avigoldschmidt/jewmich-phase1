---
import ContentPage from '../../layouts/ContentPage.astro';
import { loadPage } from '../../lib/content';

const { entry, Content } = await loadPage('students', 'high-holidays');
const { title, description, audience, registration } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  registration={registration}
  canonicalPath="/students/high-holidays"
>
  <Content />
  <p class="flag-note">
    Staff follow-up: reconcile High Holiday times before publishing any schedule
    on this landing.
  </p>
</ContentPage>
