---
import ContentPage from '../../layouts/ContentPage.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import { loadPage } from '../../lib/content';

const { entry, Content } = await loadPage('students', 'holidays');
const { title, description, audience, actions } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  actions={actions}
  canonicalPath="/students/holidays"
>
  <Content />
  <Fragment slot="after">
    <ActionPanel id="student-sukkot-rsvp" heading="Sukkot RSVP" />
    <ActionPanel id="sukkah-dinner-2nd" heading="Second-night sukkah dinner" />
    <ActionPanel id="latke-fest" heading="Latke Fest" />
    <ActionPanel id="mega-challah-bake" heading="Mega Challah Bake" />
    <ActionPanel id="purim-gift" heading="Purim gift service" />
    <ActionPanel id="student-passover-seder" heading="Student Passover seder" />
  </Fragment>
</ContentPage>
