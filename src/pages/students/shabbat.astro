---
import ContentPage from '../../layouts/ContentPage.astro';
import { loadPage } from '../../lib/content';

const { entry, Content } = await loadPage('students', 'shabbat');
const { title, description, audience, registration } = entry.data;
---

<ContentPage
  title={title}
  description={description}
  audience={audience}
  registration={registration}
  canonicalPath="/students/shabbat"
>
  <Content />
</ContentPage>
